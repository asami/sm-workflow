# WORKFLOW

## GoalPhaseWorkflow

version = goal-phase-business-operation-v6

### COMPOSITE-STATEMACHINE

#### CONSTITUENT

##### phase

state-machine = GoalPhaseRunLifecycle
subject = phaseWork
subject-type = GoalPhaseWorkRequest

##### orderedDecision

state-machine = GoalPhaseOrderedDecisionContext
subject = orderedQuestion
subject-type = GoalPhaseOrderedDecisionRequest

#### STATE

##### Pending

##### OrderedImplementation

##### OrderedInspectCandidate

##### OrderedValidation

##### OrderedReview

##### OrderedRepair

##### OrderedClosing

##### PhaseInspection

##### PhaseValidation

##### PhaseReview

##### PhaseClosing

##### PhaseDecision

##### PhaseClosed

#### DERIVATION

##### pending

state = Pending
when = phase.Idle, orderedDecision.Retained

##### ordered-implementation

state = OrderedImplementation
when = phase.Implementation, orderedDecision.Retained

##### ordered-inspection

state = OrderedInspectCandidate
when = phase.InspectCandidate, orderedDecision.Retained

##### ordered-validation

state = OrderedValidation
when = phase.Validation, orderedDecision.Retained

##### ordered-review

state = OrderedReview
when = phase.Review, orderedDecision.Retained

##### ordered-repair

state = OrderedRepair
when = phase.Repair, orderedDecision.Retained

##### ordered-closing

state = OrderedClosing
when = phase.Closing, orderedDecision.Retained

##### phase-inspection

state = PhaseInspection
when = phase.PhaseInspection, orderedDecision.Retained

##### phase-validation

state = PhaseValidation
when = phase.PhaseValidation, orderedDecision.Retained

##### phase-review

state = PhaseReview
when = phase.PhaseReview, orderedDecision.Retained

##### phase-closing

state = PhaseClosing
when = phase.PhaseClosing, orderedDecision.Retained

##### phase-decision

state = PhaseDecision
when = phase.Decision, orderedDecision.Retained

##### phase-closed

state = PhaseClosed
when = phase.Closed, orderedDecision.Retained

#### INITIAL

phase.Idle, orderedDecision.Retained

#### ACTION

##### ImplementOrderedStep

kind = OPERATION
operation = implementGoalPhaseStep
input = phase.subject

##### RepairOrderedStep

kind = OPERATION
operation = repairGoalPhaseStep
input = phase.subject

##### ReviewOrderedStep

kind = JUDGMENT
operation = reviewGoalPhaseStep
input = phase.subject
goal = ordered-step-review
context = assigned-native-step-candidate-and-checks
candidate = assigned-ordered-step
alternative = accept
alternative = repair
alternative = decision-needed
criteria = full-assigned-step-coverage
criteria = independent-reviewer-evidence
expected-result = ordered-step-review-disposition
rationale = review-rationale
evidence = actual-native-review-evidence
evidence-scope = assigned-ordered-step
evidence-freshness = assigned-task
evidence-provenance = independently-admitted-reviewer

##### AdmitOrderedStepReview

kind = ADMISSION
operation = admitOrderedStepReview
input = phase.subject
candidate-action = ReviewOrderedStep
effect = LOCAL
transaction = REQUIRED
idempotency = NOT_REQUIRED

##### ReviewWholePhase

kind = OPERATION
operation = reviewGoalPhase
input = phase.subject

##### PresentOrderedGoalDecision

kind = OPERATION
operation = presentOrderedGoalDecision
input = orderedDecision.subject

### REQUIRED-OPERATION

#### goal-phase-implementation-capability

action = ImplementOrderedStep

#### goal-phase-repair-capability

action = RepairOrderedStep

#### goal-phase-step-review-capability

action = ReviewOrderedStep

#### goal-phase-review-capability

action = ReviewWholePhase

#### goal-phase-ordered-human-capability

action = PresentOrderedGoalDecision

### OPERATION

#### advanceGoalPhase

operation = GoalPhaseService.advanceGoalPhase

#### submitGoalPhaseWorkResult

operation = GoalPhaseService.submitGoalPhaseWorkResult

#### submitGoalPhaseOrderedDecision

operation = GoalPhaseService.submitGoalPhaseOrderedDecision

#### startGoalPhase

operation = GoalPhaseService.startGoalPhase

# STATE-MACHINE

## GoalPhaseRunLifecycle

### STATE

#### Idle

##### TRANSITION

to = Implementation
on = ordered-plan-selected

#### Implementation

##### TRANSITION

to = InspectCandidate
on = implementation-result-admitted

##### TRANSITION

to = Decision
on = implementation-decision-needed

#### InspectCandidate

##### TRANSITION

to = Validation
on = candidate-observed

#### Validation

##### TRANSITION

to = Review
on = checks-passed

##### TRANSITION

to = Decision
on = checks-failed

#### Review

##### TRANSITION

to = Closing
on = review-accepted

##### TRANSITION

to = Repair
on = review-repair-admitted

##### TRANSITION

to = Decision
on = review-decision-needed

#### Repair

##### TRANSITION

to = InspectCandidate
on = repair-result-admitted

##### TRANSITION

to = Decision
on = repair-decision-needed

#### Closing

##### TRANSITION

to = Closing
on = closure-intent-saved

##### TRANSITION

to = Implementation
on = step-next-closed

##### TRANSITION

to = PhaseInspection
on = last-step-closed

#### PhaseInspection

##### TRANSITION

to = PhaseValidation
on = phase-candidate-observed

#### PhaseValidation

##### TRANSITION

to = PhaseReview
on = phase-checks-passed

##### TRANSITION

to = Decision
on = phase-checks-failed

#### PhaseReview

##### TRANSITION

to = PhaseClosing
on = phase-review-accepted

##### TRANSITION

to = Decision
on = phase-review-decision-needed

#### PhaseClosing

##### TRANSITION

to = PhaseClosing
on = phase-closure-intent-saved

##### TRANSITION

to = Closed
on = phase-repository-closed

#### Decision

##### TRANSITION

to = Implementation
on = human-semantic-resumed-Implementation

##### TRANSITION

to = Repair
on = human-semantic-resumed-Repair

##### TRANSITION

to = Review
on = human-semantic-resumed-Review

##### TRANSITION

to = PhaseReview
on = human-semantic-resumed-PhaseReview

##### TRANSITION

to = Decision
on = human-semantic-deferred

##### TRANSITION

to = Decision
on = human-semantic-cancelled

#### Closed

## GoalPhaseOrderedDecisionContext

### STATE

#### Retained

