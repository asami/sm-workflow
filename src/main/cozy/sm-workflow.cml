# WORKFLOW

## GoalPhaseWorkflow

version = goal-phase-ordered-run-v4

### COMPOSITE-STATEMACHINE

#### CONSTITUENT

##### step

state-machine = StepCloseLifecycle
subject = step
subject-type = StepCloseRequest

##### human

state-machine = GoalPhaseHumanDecisionLifecycle
subject = humanQuestion
subject-type = GoalPhaseClosureAuthorityInput

##### phase

state-machine = GoalPhaseRunLifecycle
subject = phaseWork
subject-type = GoalPhaseWorkRequest

##### orderedDecision

state-machine = GoalPhaseOrderedDecisionContext
subject = orderedQuestion
subject-type = GoalPhaseOrderedDecisionRequest

#### STATE

##### Pending

##### HumanPending

##### HumanAnswered

##### Closed

##### OrderedImplementation

##### OrderedInspectCandidate

##### OrderedValidation

##### OrderedReview

##### OrderedRepair

##### OrderedClosing

##### PhaseInspection

##### PhaseValidation

##### PhaseReview

##### PhaseClosing

##### PhaseDecision

##### PhaseClosed

#### DERIVATION

##### pending

state = Pending
when = step.Awaiting, human.Idle, phase.Idle, orderedDecision.Retained

##### human-pending

state = HumanPending
when = step.Awaiting, human.Awaiting, phase.Idle, orderedDecision.Retained

##### human-answered

state = HumanAnswered
when = step.Awaiting, human.Answered, phase.Idle, orderedDecision.Retained

##### closed

state = Closed
when = step.Closed, human.Idle, phase.Idle, orderedDecision.Retained

##### closed-human-pending

state = Closed
when = step.Closed, human.Awaiting, phase.Idle, orderedDecision.Retained

##### closed-human-answered

state = Closed
when = step.Closed, human.Answered, phase.Idle, orderedDecision.Retained

##### ordered-implementation

state = OrderedImplementation
when = step.Awaiting, human.Idle, phase.Implementation, orderedDecision.Retained

##### ordered-inspection

state = OrderedInspectCandidate
when = step.Awaiting, human.Idle, phase.InspectCandidate, orderedDecision.Retained

##### ordered-validation

state = OrderedValidation
when = step.Awaiting, human.Idle, phase.Validation, orderedDecision.Retained

##### ordered-review

state = OrderedReview
when = step.Awaiting, human.Idle, phase.Review, orderedDecision.Retained

##### ordered-repair

state = OrderedRepair
when = step.Awaiting, human.Idle, phase.Repair, orderedDecision.Retained

##### ordered-closing

state = OrderedClosing
when = step.Awaiting, human.Idle, phase.Closing, orderedDecision.Retained

##### phase-inspection

state = PhaseInspection
when = step.Awaiting, human.Idle, phase.PhaseInspection, orderedDecision.Retained

##### phase-validation

state = PhaseValidation
when = step.Awaiting, human.Idle, phase.PhaseValidation, orderedDecision.Retained

##### phase-review

state = PhaseReview
when = step.Awaiting, human.Idle, phase.PhaseReview, orderedDecision.Retained

##### phase-closing

state = PhaseClosing
when = step.Awaiting, human.Idle, phase.PhaseClosing, orderedDecision.Retained

##### phase-decision

state = PhaseDecision
when = step.Awaiting, human.Idle, phase.Decision, orderedDecision.Retained

##### phase-closed

state = PhaseClosed
when = step.Awaiting, human.Idle, phase.Closed, orderedDecision.Retained

##### mixed-implementation-awaiting-awaiting

state = PhaseDecision
when = step.Awaiting, human.Awaiting, phase.Implementation, orderedDecision.Retained

##### mixed-implementation-awaiting-answered

